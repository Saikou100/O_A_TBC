+// Aegisub: extra UI scale factor applied on top of the DPI reported by
+// Windows, so the whole interface can be enlarged independently of the
+// system-wide display scale. Must be set before any window is created.
+#define wxHAS_MSW_USER_DPI_SCALE 1
+WXDLLIMPEXP_CORE void wxMSWSetUserDPIScale(double scale);
+WXDLLIMPEXP_CORE double wxMSWGetUserDPIScale();
+WXDLLIMPEXP_CORE wxSize wxMSWApplyUserDPIScale(const wxSize& dpi);
+
 // window creation helper class: before creating a new HWND, instantiate an
