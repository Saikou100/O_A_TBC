+++ b/src/msw/window.cpp
@@ -4873,6 +4873,26 @@ wxWindowMSW::MSWOnMeasureItem(int id, WXMEASUREITEMSTRUCT *itemStruct)
 // DPI
 // ---------------------------------------------------------------------------
 
+static double gs_userDPIScale = 1.0;
+
+void wxMSWSetUserDPIScale(double scale)
+{
+    gs_userDPIScale = scale > 0.0 ? scale : 1.0;
+}
+
+double wxMSWGetUserDPIScale()
+{
+    return gs_userDPIScale;
+}
+
+wxSize wxMSWApplyUserDPIScale(const wxSize& dpi)
+{
+    if ( gs_userDPIScale == 1.0 || !dpi.x || !dpi.y )
+        return dpi;
+    return wxSize(wxRound(dpi.x * gs_userDPIScale),
+                  wxRound(dpi.y * gs_userDPIScale));
+}
+
 wxSize wxGetWindowDPI(HWND hwnd)
 {
     typedef UINT (WINAPI *GetDpiForWindow_t)(HWND hwnd);
@@ -4889,7 +4909,7 @@ wxSize wxGetWindowDPI(HWND hwnd)
     if ( s_pfnGetDpiForWindow )
     {
         const int dpi = static_cast<int>(s_pfnGetDpiForWindow(hwnd));
-        return wxSize(dpi, dpi);
+        return wxMSWApplyUserDPIScale(wxSize(dpi, dpi));
     }
 
     return wxSize();
@@ -4981,7 +5001,7 @@ wxSize wxWindowMSW::GetDPI() const
             // about doing it but still return the screen DPI which will often,
             // if not always, be the correct value to use anyhow.
             wxLogDebug("Using possibly wrong DPI for %s", wxDumpWindow(this));
-            return wxGetDPIofHDC(ScreenHDC());
+            return wxMSWApplyUserDPIScale(wxGetDPIofHDC(ScreenHDC()));
         }
     }
 
@@ -4989,7 +5009,7 @@ wxSize wxWindowMSW::GetDPI() const
 
     if ( !dpi.x || !dpi.y )
