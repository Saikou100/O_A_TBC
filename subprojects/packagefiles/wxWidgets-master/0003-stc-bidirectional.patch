+IDWriteTextFormat* wxSTCFormatOfPosition(const IScreenLine* screenLine, size_t position)
+{
+    const Font* font = screenLine->FontOfPosition(position);
+    if ( !font || !font->GetID() )
+        return nullptr;
+    wxFontWithAscent* fwa = wxFontWithAscent::FromFID(font->GetID());
+    SurfaceFontDataD2D* sfd = fwa ?
+        static_cast<SurfaceFontDataD2D*>(fwa->GetSurfaceFontData()) : nullptr;
+    return sfd && sfd->Initialised() ? sfd->GetFormat() : nullptr;
+}
+
+class wxSTCScreenLineLayout : public IScreenLineLayout
+{
+public:
+    explicit wxSTCScreenLineLayout(const IScreenLine* screenLine);
+    wxSTCScreenLineLayout(const wxSTCScreenLineLayout&) = delete;
+    wxSTCScreenLineLayout& operator=(const wxSTCScreenLineLayout&) = delete;
+
+    size_t PositionFromX(XYPOSITION xDistance, bool charPosition) override;
+    XYPOSITION XFromPosition(size_t caretPosition) override;
+    std::vector<Interval> FindRangeIntervals(size_t start, size_t end) override;
+
+private:
+    void FillTextLayoutFormats(const IScreenLine* screenLine);
+    size_t GetPositionInLayout(size_t position) const
+    {
+        return UTF16Length(m_text.substr(0, position));
+    }
+
+    wxCOMPtr<IDWriteTextLayout> m_textLayout;
+    std::string m_text;
+    std::wstring m_buffer;
+    std::vector<wxSTCBlobInline> m_blobs;
+};
+
+wxSTCScreenLineLayout::wxSTCScreenLineLayout(const IScreenLine* screenLine)
+{
+    if ( !screenLine || !screenLine->Length() )
+        return;
+
+    m_text.assign(screenLine->Text(), screenLine->Length());
+
+    IDWriteTextFormat* format = wxSTCFormatOfPosition(screenLine, 0);
+    wxCOMPtr<IDWriteFactory> factory(::wxDWriteFactory());
+    if ( !factory || !format )
+        return;
+
+    // Convert to UTF-16 and replace tabs so DirectWrite does not expand them.
+    m_buffer = wxString::FromUTF8(m_text.data(), m_text.length()).ToStdWstring();
+    std::replace(m_buffer.begin(), m_buffer.end(), L'\t', L'X');
+
+    IDWriteTextLayout* layout = nullptr;
+    const HRESULT hr = factory->CreateTextLayout(m_buffer.c_str(),
+        static_cast<UINT32>(m_buffer.length()), format,
+        static_cast<FLOAT>(screenLine->Width()),
+        static_cast<FLOAT>(screenLine->Height()), &layout);
+    if ( FAILED(hr) || !layout )
+        return;
+    m_textLayout.reset(layout);
+    layout->Release(); // reset() took its own reference
+
+    FillTextLayoutFormats(screenLine);
+}
+
+void wxSTCScreenLineLayout::FillTextLayoutFormats(const IScreenLine* screenLine)
+{
+    // Reserve up front so the pointers handed to the layout stay valid.
+    const size_t numTabs = std::count(m_text.begin(), m_text.end(), '\t');
+    m_blobs.reserve(screenLine->RepresentationCount() + numTabs);
+
+    UINT32 layoutPosition = 0;
+    for ( size_t bytePosition = 0; bytePosition < screenLine->Length(); )
+    {
+        const unsigned char uch = screenLine->Text()[bytePosition];
+        unsigned int byteCount = UTF8BytesOfLead[uch];
+        if ( !byteCount )
+            byteCount = 1;
+        const UINT32 codeUnits = UTF16LengthFromUTF8ByteCount(byteCount);
+        const DWRITE_TEXT_RANGE textRange = { layoutPosition, codeUnits };
+
+        XYPOSITION representationWidth = screenLine->RepresentationWidth(bytePosition);
+        if ( representationWidth == 0.0f && uch == '\t' )
+        {
+            FLOAT x = 0.0f, y = 0.0f;
+            DWRITE_HIT_TEST_METRICS metrics {};
+            m_textLayout->HitTestTextPosition(layoutPosition, FALSE, &x, &y, &metrics);
+            representationWidth = screenLine->TabPositionAfter(x) - x;
+        }
+        if ( representationWidth > 0.0f )
+        {
+            m_blobs.push_back(wxSTCBlobInline(representationWidth));
+            m_textLayout->SetInlineObject(&m_blobs.back(), textRange);
+        }
+
+        if ( IDWriteTextFormat* format = wxSTCFormatOfPosition(screenLine, bytePosition) )
+        {
+            const UINT32 familyLen = format->GetFontFamilyNameLength();
+            std::wstring family(familyLen + 1, L'\0');
+            if ( SUCCEEDED(format->GetFontFamilyName(&family[0], familyLen + 1)) )
+                m_textLayout->SetFontFamilyName(family.c_str(), textRange);
+
+            m_textLayout->SetFontSize(format->GetFontSize(), textRange);
+            m_textLayout->SetFontWeight(format->GetFontWeight(), textRange);
+            m_textLayout->SetFontStyle(format->GetFontStyle(), textRange);
+            m_textLayout->SetFontStretch(format->GetFontStretch(), textRange);
+
+            const UINT32 localeLen = format->GetLocaleNameLength();
+            std::wstring locale(localeLen + 1, L'\0');
+            if ( SUCCEEDED(format->GetLocaleName(&locale[0], localeLen + 1)) )
+                m_textLayout->SetLocaleName(locale.c_str(), textRange);
+
+            IDWriteFontCollection* collection = nullptr;
+            if ( SUCCEEDED(format->GetFontCollection(&collection)) && collection )
+            {
+                m_textLayout->SetFontCollection(collection, textRange);
+                collection->Release();
+            }
+        }
+
+        bytePosition += byteCount;
+        layoutPosition += codeUnits;
+    }
+}
+
+size_t wxSTCScreenLineLayout::PositionFromX(XYPOSITION xDistance, bool charPosition)
+{
+    if ( !m_textLayout )
+        return 0;
+
+    BOOL isTrailingHit = FALSE;
+    BOOL isInside = FALSE;
+    DWRITE_HIT_TEST_METRICS caretMetrics {};
+    m_textLayout->HitTestPoint(static_cast<FLOAT>(xDistance), 0.0f,
+                               &isTrailingHit, &isInside, &caretMetrics);
+
+    DWRITE_HIT_TEST_METRICS hitTestMetrics {};
+    if ( isTrailingHit )
+    {
+        FLOAT caretX = 0.0f, caretY = 0.0f;
+        // Align the caret to a whole cluster.
+        m_textLayout->HitTestTextPosition(caretMetrics.textPosition, FALSE,
+                                          &caretX, &caretY, &hitTestMetrics);
+    }
+
+    size_t pos;
+    if ( charPosition )
+        pos = isTrailingHit ? hitTestMetrics.textPosition : caretMetrics.textPosition;
+    else
+        pos = isTrailingHit ? hitTestMetrics.textPosition + hitTestMetrics.length
+                            : caretMetrics.textPosition;
+
+    return UTF8PositionFromUTF16Position(m_text, pos);
+}
+
+XYPOSITION wxSTCScreenLineLayout::XFromPosition(size_t caretPosition)
+{
+    if ( !m_textLayout )
+        return 0.0;
+
+    FLOAT x = 0.0f, y = 0.0f;
+    DWRITE_HIT_TEST_METRICS caretMetrics {};
+    m_textLayout->HitTestTextPosition(
+        static_cast<UINT32>(GetPositionInLayout(caretPosition)), FALSE,
+        &x, &y, &caretMetrics);
+    return x;
+}
+
+std::vector<Interval> wxSTCScreenLineLayout::FindRangeIntervals(size_t start, size_t end)
+{
+    std::vector<Interval> ret;
+    if ( !m_textLayout || start == end )
+        return ret;
+
+    const size_t startPos = GetPositionInLayout(start);
+    const size_t endPos = GetPositionInLayout(end);
+    const size_t rangeStart = std::min(startPos, endPos);
+    const size_t rangeLength = (endPos > startPos) ? (endPos - startPos) : (startPos - endPos);
+
+    UINT32 count = 0;
+    std::vector<DWRITE_HIT_TEST_METRICS> metrics(2);
+    m_textLayout->HitTestTextRange(static_cast<UINT32>(rangeStart),
+        static_cast<UINT32>(rangeLength), 0, 0, metrics.data(),
+        static_cast<UINT32>(metrics.size()), &count);
+    if ( count == 0 )
+        return ret;
+
+    if ( metrics.size() < count )
+    {
+        metrics.resize(count);
+        m_textLayout->HitTestTextRange(static_cast<UINT32>(rangeStart),
+            static_cast<UINT32>(rangeLength), 0, 0, metrics.data(),
+            static_cast<UINT32>(metrics.size()), &count);
+    }
+
+    for ( UINT32 i = 0; i < count && i < metrics.size(); ++i )
+    {
+        Interval interval;
+        interval.left = metrics[i].left;
+        interval.right = metrics[i].left + metrics[i].width;
+        ret.push_back(interval);
+    }
+    return ret;
+}
